<%- include('../partials/head') %>

<main class="wrap">
  <div class="page-head">
    <h1>Umsätze importieren</h1>
    <p>Zweimal täglich die Bestellungen des Shops hochladen – die Creator-Dashboards werden direkt nach dem Upload neu berechnet. Falls ein Upload mal ohne Aktualisierung bleibt, greifen die Sicherheitsläufe um <%= refreshTime %>.</p>
  </div>

  <% if (flash) { %>
    <div class="note note--good"><p><%= flash %></p></div>
  <% } %>

  <% if (result) { %>
    <div class="note note--<%= result.ok ? 'good' : 'danger' %>">
      <% if (result.ok) { %>
        <% if (result.kind === 'shares') { %>
          <p><strong><%= num(result.inserted) %> Umsatzzeilen importiert</strong><%= result.skipped ? ', ' + num(result.skipped) + ' übersprungen' : '' %> (von <%= num(result.total) %> Zeilen)<%= result.brandName ? ' für ' + result.brandName : '' %> – gebucht auf den <%= formatDateDe(result.day) %>.</p>
          <% if (result.matched && result.matched.length) { %>
            <p><strong>Zugeordnet:</strong>
              <%= result.matched.map(function (m) { return m.name + ' (' + m.rows + ')'; }).join(', ') %></p>
          <% } %>
          <% if (result.unknownNames && result.unknownNames.length) { %>
            <p><strong>Unbekannte Namen:</strong>
              <%= result.unknownNames.map(function (u) { return u.name + ' (' + u.count + ')'; }).join(', ') %>
              – diese Umsätze sind gespeichert, werden aber niemandem gutgeschrieben. Der Name in der Datei muss dem Namen des Creators im Portal entsprechen (Groß-/Kleinschreibung, Leerzeichen und Umlaute sind egal). Namen im Portal unter <a href="/admin/creators?status=approved">Creator</a> prüfen und die Datei danach erneut hochladen – diesen Import vorher <a href="/admin/import/<%= result.importId %>/zuruecknehmen">zurücknehmen</a>.</p>
          <% } %>
          <% if (result.ambiguousNames && result.ambiguousNames.length) { %>
            <p><strong>Mehrdeutige Namen:</strong>
              <%= result.ambiguousNames.map(function (u) { return u.name + ' (' + u.count + ')'; }).join(', ') %>
              – im Portal gibt es mehrere Creator mit diesem Namen. Diese Zeilen wurden niemandem zugeordnet.</p>
          <% } %>
        <% } else { %>
          <p><strong><%= num(result.inserted) %> neu, <%= num(result.updated) %> aktualisiert, <%= num(result.skipped) %> übersprungen</strong> (von <%= num(result.total) %> Zeilen)<%= result.brandName ? ' für ' + result.brandName : '' %>.</p>
          <% if (result.unknownCodes && result.unknownCodes.length) { %>
            <p><strong>Unbekannte Codes:</strong>
              <%= result.unknownCodes.map(function (u) { return u.code + ' (' + u.count + ')'; }).join(', ') %>
              – diese Bestellungen sind gespeichert, werden aber niemandem zugeordnet.</p>
          <% } %>
        <% } %>
        <% if (result.snapshot && result.snapshot.ok) { %>
          <p><strong>Dashboards aktualisiert:</strong> <%= num(result.snapshot.creators) %> Creator, <%= num(result.snapshot.orders) %> Bestellungen im aktuellen Stand.</p>
        <% } else if (result.snapshot) { %>
          <p><strong>Die Dashboards konnten nicht neu berechnet werden</strong> (<%= result.snapshot.error %>). Bitte auf der <a href="/admin">Übersicht</a> den Lauf manuell anstoßen – spätestens der nächste Sicherheitslauf holt es nach.</p>
        <% } %>
      <% } else { %>
        <p><strong>Import nicht möglich.</strong></p>
      <% } %>
      <% if (result.problems && result.problems.length) { %>
        <p class="small"><%= result.problems.slice(0, 12).join(' · ') %><%= result.problems.length > 12 ? ' · …' : '' %></p>
      <% } %>
    </div>
  <% } %>

  <div class="card">
    <form method="post" action="/admin/import" enctype="multipart/form-data">
      <div class="field">
        <label for="brand_id">Marke</label>
        <p class="hint">Zu welchem Shop gehört diese Datei?</p>
        <% if (!brandList.length) { %>
          <div class="note note--warn"><p>Noch keine aktive Marke. Lege zuerst unter <a href="/admin/brands">Marken</a> eine an.</p></div>
        <% } else { %>
        <select id="brand_id" name="brand_id" required>
          <option value="">– bitte auswählen –</option>
          <% brandList.forEach(function (b) { %>
            <option value="<%= b.id %>" <%= String(selectedBrand) === String(b.id) || (brandList.length === 1 && !selectedBrand) ? 'selected' : '' %>><%= b.name %></option>
          <% }); %>
        </select>
        <% } %>
      </div>
      <div class="field">
        <label for="file">CSV-Datei</label>
        <p class="hint">Drei Spalten: Nettoumsatz, Creatorbeteiligung in %, Creatorname. Trennzeichen , ; oder Tab. Beträge mit Komma oder Punkt. Maximal 10 MB.</p>
        <input type="file" id="file" name="file" accept=".csv,text/csv,text/plain" required>
      </div>
      <div class="checkline">
        <input type="checkbox" id="force" name="force" value="1">
        <label for="force">Trotzdem importieren, auch wenn genau diese Datei schon einmal hochgeladen wurde – normalerweise aus lassen, der Schutz verhindert doppelte Umsätze</label>
      </div>
      <div class="actions">
        <button class="btn" type="submit">Importieren und Dashboards aktualisieren</button>
        <a class="btn btn--ghost" href="/admin/import/vorlage.csv">Vorlage herunterladen</a>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>So liest das Portal die Datei</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Feld</th><th>Pflicht</th><th>Erkannte Spaltennamen</th></tr></thead>
        <tbody>
          <tr><td>Nettoumsatz</td><td>ja</td><td class="small mono">Nettoumsatz, Netto, Umsatz, Betrag, net_amount – ein Betrag je Bestellung</td></tr>
          <tr><td>Creatorbeteiligung</td><td>ja</td><td class="small mono">Creatorbeteiligung in %, Beteiligung, Provision, Anteil – als „30“, „30 %“ oder „0,3“</td></tr>
          <tr><td>Creatorname</td><td>ja</td><td class="small mono">Creatorname, Creator, Name – muss dem Namen im Portal entsprechen; alternativ der Instagram-Handle</td></tr>
        </tbody>
      </table>
    </div>
    <p class="small muted" style="margin-top:12px">
      Jede Zeile ist eine Bestellung und wird auf den Tag des Uploads gebucht. Die Datei hat keine Bestellnummern – deshalb wird derselbe Inhalt nicht zweimal angenommen. Eine Bestellliste im alten Format (mit Bestellnummer, Rabattcode und Datum) wird weiterhin erkannt und wie bisher verarbeitet.
    </p>
  </div>

  <div class="card card--flush">
    <div class="card-head"><h2>Letzte Importe</h2></div>
    <% if (!imports.length) { %>
      <div class="card-body"><p class="empty">Noch kein Import.</p></div>
    <% } else { %>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Datei</th><th>Marke</th><th>Zeitpunkt</th><th class="num">Zeilen</th><th class="num">Importiert</th><th>Nicht zugeordnet</th><th></th></tr></thead>
        <tbody>
          <% imports.forEach(function (i) {
               var open = [];
               try { open = JSON.parse(i.unknown_names || i.unknown_codes || '[]'); } catch (e) { open = []; }
          %>
          <tr>
            <td class="mono small"><%= i.filename %></td>
            <td class="small"><%= i.brand_name || '–' %></td>
            <td class="small"><%= formatDateTimeDe(i.created_at) %></td>
            <td class="num"><%= num(i.rows_total) %></td>
            <td class="num"><%= num(i.rows_inserted + i.rows_updated) %><%= i.rows_skipped ? ' <span class="muted">(' + num(i.rows_skipped) + ' übersprungen)</span>' : '' %></td>
            <td class="small"><%= open.length ? open.map(function (u) { return (u.name || u.code) + ' (' + u.count + ')'; }).join(', ') : '–' %></td>
            <td class="num"><a class="btn btn--ghost btn--sm" href="/admin/import/<%= i.id %>/zuruecknehmen">Zurücknehmen</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/foot') %>
