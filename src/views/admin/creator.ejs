<%- include('../partials/head') %>

<main class="wrap">
  <div class="page-head">
    <h1><%= c.full_name %></h1>
    <p>
      <a href="mailto:<%= c.email %>"><%= c.email %></a> ·
      Bewerbung vom <%= formatDateTimeDe(c.created_at) %>
      <% if (c.source) { %> · Quelle: <code class="mono"><%= c.source %></code><% } %>
    </p>
  </div>

  <% if (flash) { %><div class="note note--good"><p><%= flash %></p></div><% } %>
  <% if (error) { %><div class="note note--danger"><p><%= error %></p></div><% } %>

  <% if (loginLink) { %>
  <div class="card">
    <h2>Login-Link für <%= c.full_name.split(' ')[0] %></h2>
    <p class="small muted">
      <% if (hasSmtp) { %>
        Zusätzlich zur E-Mail – falls du den Link direkt schicken willst.
      <% } else { %>
        Es ist kein SMTP-Zugang hinterlegt, also verschickt das Portal nichts. Schick diesen Link dem Creator selbst.
      <% } %>
      Er ist 30 Minuten gültig und lässt sich einmal verwenden.
    </p>
    <div class="code-display">
      <div style="min-width:0;flex:1">
        <div class="mono" style="word-break:break-all;font-size:13px"><%= loginLink %></div>
      </div>
      <button class="btn btn--sm" type="button" data-copy="<%= loginLink %>">Link kopieren</button>
    </div>
  </div>
  <% } %>

  <div class="card">
    <div class="actions" style="margin-bottom:16px">
      <span class="badge badge--<%= c.status === 'approved' ? 'good' : (c.status === 'pending' ? 'warn' : (c.status === 'paused' ? 'neutral' : 'danger')) %>"><%= statusLabel(c.status) %></span>
      <a class="btn btn--ghost btn--sm" href="https://instagram.com/<%= c.instagram %>" target="_blank" rel="noopener">@<%= c.instagram %> auf Instagram</a>
      <% if (c.tiktok) { %><a class="btn btn--ghost btn--sm" href="https://tiktok.com/@<%= c.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %>
      <% if (c.youtube) { %><a class="btn btn--ghost btn--sm" href="https://youtube.com/@<%= c.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %>
      <% if (admin.role === 'owner' && (c.status === 'approved' || c.status === 'paused')) { %>
      <form method="post" action="/admin/creators/<%= c.id %>/login-link" style="margin-left:auto">
        <button class="btn btn--ghost btn--sm" type="submit">Login-Link erzeugen</button>
      </form>
      <% } %>
    </div>

    <div class="small muted">
      Zugestimmte Regeln: Version <%= c.terms_version %> am <%= formatDateTimeDe(c.terms_accepted_at) %>
      <% if (c.terms_accepted_ip) { %> · IP <%= c.terms_accepted_ip %><% } %>
    </div>
  </div>

  <% if (c.status === 'pending') { %>
  <div class="card">
    <h2>Freigeben</h2>
    <p class="small muted">Hake die Marken an, für die dieser Creator werben soll. Je Marke ein eigener Code und ein eigener Link.</p>
    <form method="post" action="/admin/creators/<%= c.id %>/approve">
      <% if (!brandList.filter(function (b) { return b.active; }).length) { %>
        <div class="note note--warn">
          <% if (admin.role === 'owner') { %><p><strong>Keine aktive Marke.</strong> Lege zuerst unter <a href="/admin/brands">Marken</a> eine an – ohne Marke gibt es keinen Link.</p><% } else { %><p><strong>Keine aktive Marke.</strong> Ohne Marke gibt es keinen Link. Sag dem Inhaber Bescheid, dass eine angelegt werden muss.</p><% } %>
        </div>
      <% } %>
      <% brandList.forEach(function (b) {
           var cur = codeByBrand[String(b.id)];
           if (!b.active && !cur) return; %>
        <div class="card" style="background:var(--surface-2);margin-bottom:12px">
          <div class="checkline">
            <input type="checkbox" id="on_<%= b.id %>" name="brand_<%= b.id %>_on" value="1" <%= cur ? 'checked' : '' %>>
            <label for="on_<%= b.id %>"><strong><%= b.name %></strong><% if (!b.active) { %> <span class="badge badge--neutral">inaktiv</span><% } %></label>
          </div>
          <div class="grid-2">
            <div class="field">
              <label for="code_<%= b.id %>">Code</label>
              <input type="text" id="code_<%= b.id %>" name="brand_<%= b.id %>_code"
                     value="<%= cur ? cur.code : c.requested_code %>"
                     style="text-transform:uppercase" maxlength="20">
            </div>
            <div class="field">
              <label for="rate_<%= b.id %>">Provision in %</label>
              <input type="text" id="rate_<%= b.id %>" name="brand_<%= b.id %>_rate"
                     value="<%= cur ? cur.commission_rate : b.default_commission_rate %>">
            </div>
          </div>
          <div class="field" style="margin-bottom:0">
            <label for="disc_<%= b.id %>">Kundenrabatt in %</label>
            <input type="text" id="disc_<%= b.id %>" name="brand_<%= b.id %>_discount"
                   value="<%= cur ? cur.customer_discount : b.default_customer_discount %>">
          </div>
          <% if (cur) { %>
            <p class="small muted" style="margin:10px 0 0;word-break:break-all">Link: <span class="mono"><%= cur.link %></span></p>
          <% } %>
        </div>
      <% }); %>
      <div class="actions">
        <button class="btn" type="submit">Freigeben und E-Mail mit den Links schicken</button>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Ablehnen</h2>
    <form method="post" action="/admin/creators/<%= c.id %>/reject">
      <div class="field">
        <label for="reason">Grund <span class="optional">– wird dem Creator mitgeteilt</span></label>
        <textarea id="reason" name="reason" placeholder="z. B. Kanal passt inhaltlich nicht zum Sortiment"></textarea>
      </div>
      <button class="btn btn--danger" type="submit">Ablehnen</button>
    </form>
  </div>
  <% } else if (c.status === 'approved' || c.status === 'paused') { %>
  <div class="card">
    <h2>Marken und Links</h2>
    <p class="small muted">Haken entfernen heißt: Der Creator verliert Code und Link für diese Marke. Bereits importierte Bestellungen bleiben davon unberührt.</p>
    <form method="post" action="/admin/creators/<%= c.id %>/codes">
      <% if (!brandList.filter(function (b) { return b.active; }).length) { %>
        <div class="note note--warn">
          <p><strong>Keine aktive Marke.</strong> Lege zuerst unter <a href="/admin/brands">Marken</a> eine an – ohne Marke gibt es keinen Link.</p>
        </div>
      <% } %>
      <% brandList.forEach(function (b) {
           var cur = codeByBrand[String(b.id)];
           if (!b.active && !cur) return; %>
        <div class="card" style="background:var(--surface-2);margin-bottom:12px">
          <div class="checkline">
            <input type="checkbox" id="on_<%= b.id %>" name="brand_<%= b.id %>_on" value="1" <%= cur ? 'checked' : '' %>>
            <label for="on_<%= b.id %>"><strong><%= b.name %></strong><% if (!b.active) { %> <span class="badge badge--neutral">inaktiv</span><% } %></label>
          </div>
          <div class="grid-2">
            <div class="field">
              <label for="code_<%= b.id %>">Code</label>
              <input type="text" id="code_<%= b.id %>" name="brand_<%= b.id %>_code"
                     value="<%= cur ? cur.code : c.requested_code %>"
                     style="text-transform:uppercase" maxlength="20">
            </div>
            <div class="field">
              <label for="rate_<%= b.id %>">Provision in %</label>
              <input type="text" id="rate_<%= b.id %>" name="brand_<%= b.id %>_rate"
                     value="<%= cur ? cur.commission_rate : b.default_commission_rate %>">
            </div>
          </div>
          <div class="field" style="margin-bottom:0">
            <label for="disc_<%= b.id %>">Kundenrabatt in %</label>
            <input type="text" id="disc_<%= b.id %>" name="brand_<%= b.id %>_discount"
                   value="<%= cur ? cur.customer_discount : b.default_customer_discount %>">
          </div>
          <% if (cur) { %>
            <p class="small muted" style="margin:10px 0 0;word-break:break-all">Link: <span class="mono"><%= cur.link %></span></p>
          <% } %>
        </div>
      <% }); %>
      <div class="actions">
        <button class="btn" type="submit">Marken speichern</button>
        <span class="small muted">Eine Codeänderung wirkt erst ab dem nächsten Import – alte Bestellungen bleiben dem alten Code zugeordnet.</span>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Status und Notiz</h2>
    <form method="post" action="/admin/creators/<%= c.id %>/update">
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="approved" <%= c.status === 'approved' ? 'selected' : '' %>>Aktiv</option>
          <option value="paused" <%= c.status === 'paused' ? 'selected' : '' %>>Pausiert</option>
        </select>
      </div>
      <div class="field">
        <label for="note_internal">Interne Notiz <span class="optional">– sieht der Creator nicht</span></label>
        <textarea id="note_internal" name="note_internal"><%= c.note_internal || '' %></textarea>
      </div>
      <div class="actions">
        <button class="btn" type="submit">Speichern</button>
      </div>
    </form>
  </div>

  <div class="card card--flush">
    <div class="card-head">
      <h2>Umsatz laut Snapshot</h2>
      <span class="sub"><%= run ? run.as_of_label : 'kein Snapshot' %></span>
    </div>
    <div class="card-body">
      <% if (!totals) { %>
        <p class="empty">Für diesen Creator liegen im letzten Snapshot keine Werte vor.</p>
      <% } else { %>
      <div class="stats" style="margin:0">
        <div class="stat"><div class="stat-label">Umsatz gesamt</div><div class="stat-value"><%= money(totals.revenue_total) %></div></div>
        <div class="stat"><div class="stat-label">Provision gesamt</div><div class="stat-value"><%= money(totals.commission_total) %></div></div>
        <div class="stat"><div class="stat-label">Offen</div><div class="stat-value"><%= money(totals.commission_open) %></div></div>
        <div class="stat"><div class="stat-label">Bestellungen</div><div class="stat-value"><%= num(totals.orders_total) %></div></div>
      </div>
      <% } %>
    </div>
  </div>

  <% if (admin.role === 'owner') { %>
  <div class="card">
    <h2>Zahlungsempfänger</h2>
    <% if (!bank) { %>
      <div class="note note--warn">
        <p>
          <strong>Noch keine Auszahlungsdaten.</strong>
          <%= c.full_name.split(' ')[0] %> hat sie noch nicht eingetragen. Im Dashboard steht ein Hinweis darauf –
          bei offener Provision lohnt sich trotzdem eine kurze Nachricht.
        </p>
      </div>
    <% } else { %>
      <div class="table-scroll">
        <table>
          <tbody>
            <tr><th>Kontoinhaber</th><td><%= bank.account_holder %></td></tr>
            <% if (bank.method === 'sepa') { %>
              <tr><th>IBAN</th><td class="mono"><%= formatIban(bank.iban) %></td></tr>
              <% if (bank.bic) { %><tr><th>BIC</th><td class="mono"><%= bank.bic %></td></tr><% } %>
            <% } else { %>
              <tr><th>PayPal</th><td class="mono"><%= bank.paypal_email %></td></tr>
            <% } %>
            <tr><th>Anschrift</th><td><%= bank.street %>, <%= bank.postal_code %> <%= bank.city %>, <%= bank.country %></td></tr>
            <tr><th>Steuerlicher Status</th><td><%= taxStatusLabel[bank.tax_status] || bank.tax_status %></td></tr>
            <% if (bank.tax_id) { %><tr><th>USt-IdNr. / Steuernummer</th><td class="mono"><%= bank.tax_id %></td></tr><% } %>
            <tr><th>Zuletzt geändert</th><td><%= formatDateTimeDe(bank.updated_at) %></td></tr>
          </tbody>
        </table>
      </div>
      <% if (bank.tax_status === 'privat') { %>
        <div class="note note--warn" style="margin-top:12px">
          <p class="small">
            Als Privatperson ohne unternehmerische Tätigkeit kann keine Gutschrift nach § 14 Abs. 2 UStG ausgestellt
            werden. Kläre vor der ersten Zahlung mit deinem Steuerbüro, wie ihr das abrechnet.
          </p>
        </div>
      <% } %>
    <% } %>
  </div>

  <div class="card">
    <h2>Auszahlung erfassen</h2>
    <form method="post" action="/admin/payouts">
      <input type="hidden" name="creator_id" value="<%= c.id %>">
      <div class="grid-2">
        <div class="field">
          <label for="period">Zeitraum</label>
          <input type="text" id="period" name="period" placeholder="2026-08" value="<%= defaultPeriod %>" required>
        </div>
        <div class="field">
          <label for="amount">Betrag in <%= program.currency %></label>
          <input type="number" id="amount" name="amount" step="0.01" min="0" required
                 value="<%= totals ? totals.commission_open.toFixed(2) : '' %>">
        </div>
      </div>
      <div class="actions">
        <button class="btn btn--ghost" type="submit" name="status" value="open">Als offen anlegen</button>
        <button class="btn" type="submit" name="status" value="paid">Als ausgezahlt buchen</button>
      </div>
    </form>
  </div>
  <% } %>
  <% } else { %>
  <div class="card">
    <div class="note note--danger">
      <p><strong>Abgelehnt</strong><% if (c.decision_reason) { %> – <%= c.decision_reason %><% } %></p>
    </div>
    <form method="post" action="/admin/creators/<%= c.id %>/reopen">
      <button class="btn btn--ghost" type="submit">Wieder auf „offen“ setzen</button>
    </form>
  </div>
  <% } %>

  <p><a href="/admin/creators">← Zurück zur Liste</a></p>

</main>

<script>
document.addEventListener('click', function (e) {
  var btn = e.target.closest('[data-copy]');
  if (!btn) return;
  navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function () {
    var old = btn.textContent;
    btn.textContent = 'Kopiert';
    setTimeout(function () { btn.textContent = old; }, 1600);
  });
});
</script>

<%- include('../partials/foot') %>
