<%- include('partials/head') %>

<main class="wrap">
  <div class="page-head">
    <h1>Hallo <%= creator.full_name.split(' ')[0] %></h1>
    <p>
      <% if (run) { %>
        Stand: <strong><%= run.as_of_label %></strong> · aktualisiert zweimal täglich, sobald die neuen Bestellungen eingespielt sind (spätestens <%= nextRefresh %>)
      <% } else { %>
        Die erste Aktualisierung kommt mit dem ersten Einspielen der Bestellungen, spätestens <%= nextRefresh %>.
      <% } %>
    </p>
  </div>


  <% brandCards.forEach(function (b) { %>
    <div class="card">
      <div class="card-head" style="padding:0 0 12px">
        <h2><%= b.brand_name %></h2>
        <% if (b.code) { %><span class="sub"><%= percent(b.commission_rate) %> Provision · <%= percent(b.customer_discount) %> Rabatt für deine Community</span><% } %>
      </div>

      <% if (b.code) { %>
      <div class="field" style="margin-bottom:12px">
        <label for="link_<%= b.brand_id %>">Dein Link – den postest du</label>
        <div class="code-display" style="gap:10px">
          <div style="min-width:0;flex:1">
            <div class="mono" id="link_<%= b.brand_id %>" style="word-break:break-all;font-size:13px"><%= b.link %></div>
          </div>
          <button class="btn btn--sm" type="button" data-copy="<%= b.link %>">Link kopieren</button>
        </div>
      </div>

      <div class="code-display">
        <div>
          <div class="stat-label">Dein Code</div>
          <div class="code-value" style="font-size:22px"><%= b.code %></div>
        </div>
        <% if (b.totals) { %>
          <div>
            <div class="stat-label">Umsatz 30 Tage</div>
            <div class="stat-value" style="font-size:20px"><%= money(b.totals.revenue_30d) %></div>
          </div>
          <div>
            <div class="stat-label">Deine Provision 30 Tage</div>
            <div class="stat-value" style="font-size:20px"><%= money(b.totals.commission_30d) %></div>
          </div>
        <% } %>
        <button class="btn btn--ghost btn--sm" type="button" data-copy="<%= b.code %>" style="margin-left:auto">Code kopieren</button>
      </div>

      <p class="small muted" style="margin:12px 0 0">
        Falls jemand lieber selbst tippt: Der Code funktioniert im Warenkorb genauso. Zugeordnet wird beides.
      </p>
      <% } else if (b.totals) { %>
      <div class="code-display">
        <div>
          <div class="stat-label">Umsatz 30 Tage</div>
          <div class="stat-value" style="font-size:20px"><%= money(b.totals.revenue_30d) %></div>
        </div>
        <div>
          <div class="stat-label">Deine Provision 30 Tage</div>
          <div class="stat-value" style="font-size:20px"><%= money(b.totals.commission_30d) %></div>
        </div>
      </div>
      <% } %>
    </div>
  <% }); %>


  <% if (!totals) { %>
    <div class="note note--info">
      <p><strong>Noch keine Zahlen.</strong> Sobald deine erste Bestellung eingespielt ist, siehst du sie hier – spätestens <%= nextRefresh %>.</p>
    </div>
  <% } else { %>

  <div class="stats">
    <div class="stat">
      <div class="stat-label">Umsatz gesamt</div>
      <div class="stat-value"><%= money(totals.revenue_total) %></div>
      <div class="stat-sub"><%= num(totals.orders_total) %> <%= totals.orders_total === 1 ? 'Bestellung' : 'Bestellungen' %></div>
    </div>
    <div class="stat">
      <div class="stat-label">Provision gesamt</div>
      <div class="stat-value"><%= money(totals.commission_total) %></div>
      <div class="stat-sub"><%= money(totals.commission_30d) %> in den letzten 30 Tagen</div>
    </div>
    <div class="stat">
      <div class="stat-label">Umsatz 30 Tage</div>
      <div class="stat-value"><%= money(totals.revenue_30d) %></div>
      <% const d = delta(totals.revenue_30d, totals.revenue_prev30d); %>
      <div class="stat-delta <%= d.direction %>"><%= d.text %> vs. 30 Tage davor</div>
    </div>
    <div class="stat">
      <div class="stat-label">Ø Bestellwert</div>
      <div class="stat-value"><%= money(totals.avg_order_value) %></div>
      <div class="stat-sub">
        <% if (totals.last_sale_date) { %>letzte Bestellung <%= formatDateDe(totals.last_sale_date) %><% } else { %>–<% } %>
      </div>
    </div>
  </div>

  <div class="card card--flush">
    <div class="card-head">
      <h2>Umsatz der letzten 30 Tage</h2>
      <span class="sub">Nur bestätigte Bestellungen · Retouren fallen wieder heraus</span>
    </div>
    <div class="card-body">
      <%- chartHtml %>
    </div>
  </div>

  <div class="card card--flush">
    <div class="card-head">
      <h2>Bestellungen</h2>
      <span class="sub"><%= num(orders.length) %> zuletzt erfasst</span>
    </div>
    <% if (!orders.length) { %>
      <div class="card-body"><p class="empty">Noch keine Bestellungen erfasst.</p></div>
    <% } else { %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Datum</th>
            <th>Marke</th>
            <th>Bestellung</th>
            <th>Status</th>
            <th class="num">Umsatz</th>
            <th class="num">Deine Provision</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function (o) { %>
          <tr>
            <td><%= formatDateDe(o.order_date) %></td>
            <td class="small"><%= o.brand_name || '–' %></td>
            <td class="mono"><%= o.order_ref %></td>
            <td>
              <span class="badge badge--<%= o.status === 'confirmed' ? 'good' : (o.status === 'pending' ? 'warn' : 'danger') %>"><%= statusLabel(o.status) %></span>
            </td>
            <td class="num"><%= money(o.revenue) %></td>
            <td class="num"><%= o.commission ? money(o.commission) : '–' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <% } %>

</main>

<script>
document.addEventListener('click', function (e) {
  var btn = e.target.closest('[data-copy]');
  if (!btn) return;
  navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function () {
    var old = btn.textContent;
    btn.textContent = 'Kopiert';
    setTimeout(function () { btn.textContent = old; }, 1600);
  });
});
</script>

<%- include('partials/foot') %>
