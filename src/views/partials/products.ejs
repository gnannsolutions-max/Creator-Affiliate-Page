<!-- Produktsektion "Unsere neuesten Produkte" (Hytovia).
     Wird in home.ejs eingebunden. Bilder: public/products/<slug>.jpg -->
<style>
#snc-page .snc-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
#snc-page .snc-prod{
  background:linear-gradient(180deg,var(--snc-bg-3),var(--snc-bg-2));
  border:1px solid var(--snc-line);border-radius:var(--snc-radius);
  padding:14px 14px 20px;display:flex;flex-direction:column;
  transition:border-color .2s ease,transform .2s ease;
}
#snc-page .snc-prod:hover{border-color:var(--snc-line-strong);transform:translateY(-3px);}
#snc-page .snc-prod-img{
  position:relative;aspect-ratio:1/1;border-radius:12px;overflow:hidden;
  background:#FAFAFA;display:grid;place-items:center;margin-bottom:16px;
}
#snc-page .snc-prod-img img{width:100%;height:100%;object-fit:contain;}
#snc-page .snc-prod-ph{
  display:flex;flex-direction:column;align-items:center;gap:8px;
  color:#A9AFB2;font-size:.82rem;font-weight:500;
}
#snc-page .snc-prod-ph svg{width:26px;height:26px;}
#snc-page .snc-prod-badge{
  position:absolute;top:10px;right:10px;
  font-size:11px;font-weight:600;letter-spacing:.02em;
  padding:5px 10px;border-radius:999px;
  background:rgba(10,12,14,.82);color:#E8ECEA;backdrop-filter:blur(6px);
}
#snc-page .snc-prod--out .snc-prod-img img{filter:grayscale(.55);opacity:.62;}
#snc-page .snc-prod--out .snc-prod-cat,#snc-page .snc-prod--out h3{opacity:.72;}
#snc-page .snc-prod-cat{
  display:block;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--snc-muted);margin-bottom:6px;padding:0 2px;
}
#snc-page .snc-prod h3{font-size:1rem;letter-spacing:-.015em;padding:0 2px;margin:0;}
#snc-page .snc-prod-note{margin-top:26px;font-size:.92rem;color:var(--snc-muted);max-width:70ch;}
@media (max-width:960px){
  #snc-page .snc-prod-grid{grid-template-columns:repeat(3,1fr);}
}
@media (max-width:640px){
  #snc-page .snc-prod-grid{grid-template-columns:repeat(2,1fr);gap:12px;}
  #snc-page .snc-prod{padding:10px 10px 16px;}
  #snc-page .snc-prod h3{font-size:.92rem;}
}
</style>

